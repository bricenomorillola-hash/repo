# Copie este archivo como ".env" y cambie los valores.
# El .env no se sube a GitHub.

PORT=3010

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=examen_proveedores

# Frase secreta para firmar los JWT (algo largo y difícil)
JWT_SECRET=cambie_esta_frase_secreta_por_una_larga
JWT_EXPIRA=2h

# Contraseñas de los usuarios de prueba que crea "npm run seed"
SEED_ADMIN_PASSWORD=Admin123*
SEED_EDITOR_PASSWORD=Editor123*
SEED_USUARIO_PASSWORD=Usuario123*
